# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://petbf:petbf@localhost:5432/petbf?schema=public
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000
# Genera uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Opcional: SEED_DEMO=true añade productos, animales y una tasa de ejemplo.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO=false
# Intentos por minuto en registro y login (10 por defecto; súbelo solo para pruebas).
AUTH_THROTTLE_LIMIT=10
# Peticiones por minuto y por IP en el resto de rutas (120 por defecto).
THROTTLE_LIMIT=120
# Secreto compartido con la web (el mismo valor en apps/web). Con él, la API acepta
# la IP real del cliente que reenvía la web. Genera uno con: openssl rand -base64 48
WEB_PROXY_SECRET=

# Correos al cliente: "log" los escribe en el registro; "resend" los envía.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="Petbf <no-responder@petbf.local>"
# Dirección pública de la tienda, para los enlaces de los correos.
WEB_URL=http://localhost:3000
