// Modelo de datos de Petbf (fase 0: cimientos).
// Convenciones:
// - Ids UUID generados por la base de datos.
// - Dinero en céntimos enteros de USD (Int) para evitar errores de coma flotante.
//   Bs y euros se calculan con la tasa vigente y el pedido guardará su propia tasa.
// - Tablas en snake_case y plural con @@map; campos en camelCase en el código.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Usuarios, sesiones y auditoría ----------

// Una persona puede tener varios roles (por ejemplo catálogo y adopciones).
enum Role {
  CUSTOMER // cliente registrado; todos lo tienen
  ADMIN // dueño: acceso total, gestiona cuentas y roles
  ORDERS_OPERATOR // verifica pagos y gestiona pedidos
  CATALOG_MANAGER // productos, precios, stock y animales en venta
  ADOPTION_COORDINATOR // fichas de adopción y solicitudes
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique // siempre en minúsculas (lo normaliza la API)
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles            UserRole[]           @relation("UserRoles")
  rolesGranted     UserRole[]           @relation("RolesGranted")
  sessions         Session[]
  auditLogs        AuditLog[]
  addresses        Address[]
  cartItems        CartItem[]
  orders           Order[]
  orderChanges     OrderStatusHistory[]
  paymentsVerified Payment[]
  returns          ReturnRequest[]      @relation("ReturnCustomer")
  returnsDecided   ReturnRequest[]      @relation("ReturnDecider")
  returnsRefunded  ReturnRequest[]      @relation("ReturnRefunder")

  @@map("users")
}

model UserRole {
  userId      String   @db.Uuid
  role        Role
  grantedById String?  @db.Uuid // null si lo asignó el sistema (registro o seed)
  grantedAt   DateTime @default(now())

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RolesGranted", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

// Una sesión por dispositivo. Guarda solo el hash del refresh token.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Registro de acciones sensibles: quién hizo qué, sobre qué y cuándo.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid // null si la acción la hizo el sistema
  action     String // por ejemplo "auth.login", "user.role_changed"
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------- Catálogo de productos ----------

enum Species {
  DOG
  CAT
  BIRD
  FISH
  RODENT
  REPTILE
  OTHER
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  parentId  String?  @db.Uuid
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  products Product[]

  @@map("brands")
}

model Product {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  description  String
  categoryId   String    @db.Uuid
  brandId      String?   @db.Uuid
  species      Species[] // especies a las que va dirigido
  // false para alimento e higiene: no admiten devolución una vez abiertos.
  isReturnable Boolean   @default(true)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@map("products")
}

// Lo que realmente se compra: "Saco 3 kg", "Saco 15 kg". El stock vive aquí.
model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @db.Uuid
  sku               String   @unique
  name              String
  priceUsdCents     Int
  compareAtUsdCents Int? // precio anterior para mostrar ofertas
  stock             Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  url       String
  alt       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ---------- Animales: venta y adopción ----------

enum AnimalListingType {
  SALE
  ADOPTION
}

enum AnimalStatus {
  AVAILABLE
  RESERVED
  SOLD
  ADOPTED
  UNAVAILABLE
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

model Animal {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  slug          String            @unique
  listingType   AnimalListingType
  status        AnimalStatus      @default(AVAILABLE)
  species       Species
  breed         String?
  sex           Sex               @default(UNKNOWN)
  birthDate     DateTime?         @db.Date
  description   String
  priceUsdCents Int? // null en adopción
  isVaccinated  Boolean           @default(false)
  isSterilized  Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  images AnimalImage[]

  @@index([listingType, status])
  @@map("animals")
}

model AnimalImage {
  id        String @id @default(uuid()) @db.Uuid
  animalId  String @db.Uuid
  url       String
  alt       String
  sortOrder Int    @default(0)

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@map("animal_images")
}

// ---------- Monedas y tasas ----------

enum Currency {
  USD
  VES
  EUR
  USDT
}

// Tasa oficial tal como la publica la fuente: 1 `base` = `rate` `quote`.
// Ej.: base USD, quote VES, rate 245.67 (Bs por dólar); base EUR, quote VES.
model ExchangeRate {
  id          String   @id @default(uuid()) @db.Uuid
  base        Currency
  quote       Currency
  rate        Decimal  @db.Decimal(20, 8)
  source      String
  effectiveAt DateTime
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([base, quote, source, effectiveAt])
  @@index([base, quote, effectiveAt])
  @@map("exchange_rates")
}

// ---------- Inventario ----------

enum InventoryReason {
  RESTOCK // reposición
  SALE // venta (al crear el pedido)
  CANCELLATION // el pedido se canceló y el stock vuelve
  RETURN // devolución
  ADJUSTMENT // ajuste manual
}

// Cada cambio de stock deja un movimiento en la misma transacción.
model InventoryMovement {
  id            String          @id @default(uuid()) @db.Uuid
  variantId     String          @db.Uuid
  quantityDelta Int // negativo cuando sale stock
  reason        InventoryReason
  note          String?
  orderId       String?         @db.Uuid
  createdById   String?         @db.Uuid // null si lo hizo el sistema
  createdAt     DateTime        @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ---------- Clientes: direcciones y carrito ----------

// Estado, ciudad y punto de referencia, como se usan en Venezuela.
model Address {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  recipientName  String
  phone          String
  state          String // uno de los 24 estados (lo valida la API)
  city           String
  municipality   String?
  line1          String
  referencePoint String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// Un carrito por cliente con sesión: una fila por presentación.
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("cart_items")
}

// ---------- Envíos y métodos de pago ----------

model ShippingZone {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  states           String[] // estados que cubre
  carrier          String // agencia o "Delivery propio"
  priceUsdCents    Int
  freeOverUsdCents Int      @default(2500) // envío gratis desde 25 $
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("shipping_zones")
}

enum PaymentMethodCode {
  PAGO_MOVIL
  TRANSFER_VES
  ZELLE
  CASH_USD
  TRANSFER_EUR
  USDT
}

// Los datos de cuenta que ve el cliente salen de aquí y los edita el administrador.
model PaymentMethod {
  id           String            @id @default(uuid()) @db.Uuid
  code         PaymentMethodCode @unique
  name         String
  currency     Currency
  instructions String
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  orders   Order[]
  payments Payment[]

  @@map("payment_methods")
}

// ---------- Pedidos y pagos ----------

enum OrderStatus {
  PENDING_PAYMENT // creado; el cliente tiene 2 horas para reportar el pago
  PAYMENT_REPORTED // el cliente reportó; falta que el equipo lo verifique
  PAID // el equipo verificó el pago
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Precios, tasas y dirección se copian al pedido: un cambio posterior no altera el pasado.
model Order {
  id               String      @id @default(uuid()) @db.Uuid
  number           Int         @unique @default(autoincrement()) // se muestra como PB-000123
  userId           String      @db.Uuid
  status           OrderStatus @default(PENDING_PAYMENT)
  paymentMethodId  String      @db.Uuid
  chargedCurrency  Currency
  // Tasas BCV congeladas al crear el pedido (Bs por 1 USD y por 1 EUR).
  usdVesRate       Decimal?    @db.Decimal(20, 8)
  eurVesRate       Decimal?    @db.Decimal(20, 8)
  rateEffectiveAt  DateTime?
  subtotalUsdCents Int
  shippingUsdCents Int
  totalUsdCents    Int
  totalCharged     Decimal     @db.Decimal(20, 8) // monto exacto a pagar en chargedCurrency
  recipientName    String
  phone            String
  state            String
  city             String
  municipality     String?
  line1            String
  referencePoint   String?
  shippingZoneName String
  carrier          String
  trackingCode     String?
  paymentDueAt     DateTime
  termsAcceptedAt  DateTime
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  history       OrderStatusHistory[]
  payments      Payment[]
  movements     InventoryMovement[]
  returns       ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status, paymentDueAt])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  orderId           String  @db.Uuid
  variantId         String? @db.Uuid
  productName       String
  productSlug       String
  variantName       String
  sku               String
  unitPriceUsdCents Int
  quantity          Int
  isReturnable      Boolean

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

// Un registro por cada cambio de estado del pedido.
model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?      @db.Uuid // null si lo hizo el sistema
  note        String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum PaymentStatus {
  REPORTED
  VERIFIED
  REJECTED
}

// Pago reportado por el cliente. Solo cuenta cuando el equipo lo verifica.
// Un índice único parcial (en la migración) impide que una referencia
// verificada pague dos pedidos con el mismo método.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @db.Uuid
  methodId        String        @db.Uuid
  currency        Currency
  amount          Decimal       @db.Decimal(20, 8)
  reference       String // normalizada: sin espacios y en mayúsculas
  originBank      String?
  paidAt          DateTime
  status          PaymentStatus @default(REPORTED)
  verifiedById    String?       @db.Uuid
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())

  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method     PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  verifiedBy User?         @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  proof      PaymentProof?

  @@index([status, createdAt])
  @@index([orderId])
  @@map("payments")
}

enum ReturnStatus {
  REQUESTED // el cliente la pidió; el equipo la revisa
  APPROVED // aceptada: falta recibir el producto y reembolsar
  REJECTED
  REFUNDED // el administrador devolvió el dinero
}

// Devolución de un pedido entregado, como máximo 3 días después de la entrega.
// El reembolso va por el mismo método y en la misma moneda del pedido.
model ReturnRequest {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  userId          String       @db.Uuid
  status          ReturnStatus @default(REQUESTED)
  reason          String
  // Monto congelado al pedirla, con las tasas del pedido. El envío no se reembolsa.
  refundUsdCents  Int
  currency        Currency
  refundAmount    Decimal      @db.Decimal(20, 8)
  decisionNote    String?
  decidedById     String?      @db.Uuid
  decidedAt       DateTime?
  refundReference String?
  restocked       Boolean      @default(false)
  refundedById    String?      @db.Uuid
  refundedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user       User         @relation("ReturnCustomer", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy  User?        @relation("ReturnDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  refundedBy User?        @relation("ReturnRefunder", fields: [refundedById], references: [id], onDelete: SetNull)
  items      ReturnItem[]

  // Además, un índice único parcial impide dos devoluciones abiertas del mismo pedido.
  @@index([status, createdAt])
  @@index([orderId])
  @@map("return_requests")
}

model ReturnItem {
  id          String @id @default(uuid()) @db.Uuid
  returnId    String @db.Uuid
  orderItemId String @db.Uuid
  quantity    Int

  request   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

// Comprobante que adjunta el cliente: una pista para el equipo, no una prueba.
// Se guarda en la base (privado, con respaldo) y solo se sirve con sesión.
model PaymentProof {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @db.Uuid
  contentType String // detectado por los primeros bytes, no por lo que diga el cliente
  sizeBytes   Int
  sha256      String
  data        Bytes
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_proofs")
}

enum EmailStatus {
  PENDING // por enviar (o reintentar)
  SENT
  FAILED // agotó los reintentos
}

// Bandeja de salida: los correos se guardan en la misma transacción que el
// cambio que los origina y un proceso los envía después. Si el proveedor
// falla, el pedido no se pierde y el correo se reintenta.
model EmailOutbox {
  id            String      @id @default(uuid()) @db.Uuid
  to            String
  subject       String
  text          String
  kind          String // order.created, order.paid, return.refunded…
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastError     String?
  nextAttemptAt DateTime    @default(now())
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}
